function GetPerforamceMatrix(ReviewYears, ReviewTypeKPI, ReviewTypeOBJ, filterc) {
    $('.employeecount span').html('<i class="fa fa-spinner fa-spin"></i>');

    var params = {
        ReviewYear: ReviewYears.val()[0],
        ReviewTypeKPI: ReviewTypeKPI.val()[0],
        ReviewTypeOBJ: ReviewTypeOBJ.val()[0],
        filterc: filterc
    }

    populateMatrixD('matrix11', 1, 1, params);
    populateMatrixD('matrix12', 1, 2, params);
    populateMatrixD('matrix13', 1, 3, params);

    populateMatrixD('matrix21', 2, 1, params);
    populateMatrixD('matrix22', 2, 2, params);
    populateMatrixD('matrix23', 2, 3, params);

    populateMatrixD('matrix31', 3, 1, params);
    populateMatrixD('matrix32', 3, 2, params);
    populateMatrixD('matrix33', 3, 3, params);
}

function populateMatrixD(matrixNo, KPI, OBJ, filterc) {

    try {

        var paramsData = {
            pReviewTypeIDKPI: filterc.ReviewTypeKPI,
            pReviewTypeIDOBJ: filterc.ReviewTypeOBJ,
            pReviewYear: filterc.ReviewYear,
            pFilterCriteria: filterc.filterc,
            pKPI: KPI,
            pOBJ: OBJ,
        }

        postRequestD('GetDataForPerformancePotentialMatrix2', paramsData, function (response) {
            var data = JSON.parse(response.d);

            ////console.log(data);
            data_ = data.Data;
            var Ratings = data.RatingTitle;
            var userdt = data.UserDetail;
            var dtemppic = data.EmployeePics;
            ////console.log({ userdt });

            $('#' + matrixNo + ' .employeecount span').html(data_.length);
            $('#' + matrixNo).click(function (e) {

                var template = '';

                template = '';
                $.each(userdt, function (i, item) {
                    var sno = i + 1;
                    var empimage = '';
                    var picpath = dtemppic.filter(function (value) {
                        return item.EmployeeID = value.EmployeeID;
                    });


                    //if (picpath.length > 0) {
                    //empimage = '../' + picpath[0].EmployeeImage;
                    // } else {
                    //   empimage = 'img/avatar.png';
                    //}
                    empimage = 'assets/images/avataruser.png';

                    template += '<tr>' +
                        '<td>' + sno + '</td>' +
                        '<td style="text-align:center;">' +
                        '<img src="' + empimage + '"  class="img img-circle img-thumbnail userpic" ></td> ' +
                        '<td> ' + item.EmployeeRefNo + '</td> ' +
                        '<td>' + item.EmployeeName + '</td>' +
                        '<td>' + item.DesignationTitle + '</td>' +
                        '<td>' + item.DepartmentTitle + '</td>' +
                        '<td>' + item.BranchTitle + '</td>' +
                        '<td>' + item.DivisionTitle + '</td>' +
                        '<td>' + item.GroupLevelTitle + '</td>' +
                        '<td>' + item.GradeTitle + '</td>' +
                        '<td>' + item.Email + '</td>' +
                        '<td>' + getFormattedDateNew(item.BirthDate, '') + '</td>' +
                        '<td>' + item.Age + '</td>' +
                        '<td>' + item.Sex + '</td>' +
                        '<td>' + item.QualificationTitle + '</td>' +
                        '<td>' + getFormattedDateNew(item.AppointmentDate, '') + '</td>' +
                        '<td>' + item.ServicePeriod + '</td>' +
                        '<td>' + getFormattedDateNew(item.PromotionDate, '') + '</td>' +
                        '<td>' + item.PromotionPeriod + '</td>' +

                        '</tr>'
                });

                var table = '<div class="table-responsive"><table class="table table-bordered">' +
                    '<thead>' +
                    '<tr>' +
                    '<th>Sno.</th>' +
                    '<th></th>' +
                    '<th>Employee ID</th>' +
                    '<th>Employee Name</th>' +
                    '<th>Designation</th>' +
                    '<th>Department</th>' +
                    '<th>Branch</th>' +
                    '<th>Division</th>' +
                    '<th>Function</th>' +
                    '<th>Group</th>' +
                    '<th>Email Address</th>' +
                    '<th>Birth Date</th>' +
                    '<th>Age</th>' +
                    '<th>Gender</th>' +
                    '<th>Qualification</th>' +
                    '<th>Appointment Date</th>' +
                    '<th>Service Period</th>' +
                    '<th>Last Promotion Date</th>' +
                    '<th>Last Promotion Period</th>' +
                    '</tr>' +
                    '</thead>' +
                    '<tbody>             ' +
                    template +
                    '</tbody>' +
                    '</table></div>';


                $('#listcontainer').html(table);
                $("#myModal").modal('show');
            });
        });

    } catch (error) {
        ////console.log(error);
    }


}

function validateAppraisalCriteria(pFirstLoad) {
    var ReviewYears = $('#ddlReviewYear');
    var ReviewTypeKPI = $('#ddlReviewType');
    var ReviewTypeOBJ = $('#ddlReviewType2');

    if (pFirstLoad) { return; }
    var validateMsg = '';
    if (isNull(ReviewYears.val())) {
        $('.innerFilterDiv').slideDown();
        validateMsg += 'Select Review Year! \n';
    }
    if (isNull(ReviewTypeKPI.val())) {
        $('.innerFilterDiv').slideDown();
        validateMsg += 'Select Review Type!';
    }


    if (validateMsg.length > 0) {
        alert(validateMsg);
        return false;
    } else {

        if (isNull(ReviewTypeOBJ.val())) {
            ReviewTypeOBJ.val(ReviewTypeKPI.val());
        }
        return true;
    }
}

function getCheckedCheckboxesFor(checkboxName) {
    var checkboxes = document.querySelectorAll('input[name="' + checkboxName + '"]:checked'), values = [];
    Array.prototype.forEach.call(checkboxes, function (el) {
        values.push(el.value);
    });
    return values;
}



function createPayrollFilter() {

    var placeholder = $('#' + FType + 'FilterDiv');

    if (FType == 'payrolldashboard' || FType == 'attendancedashboard') {

        var years_ = getYearsArrayFromToNow('2012');
        //years_ = years_.split(',');

        var template = '';

        $.each(years_, function (i, item) {
            var checkedYr = '';
            if (item == sysdate.split('/')[2]) { checkedYr = 'checked' }
            //template += '<span> <input name="payrollYears" type="checkbox" value="' + item + '" class="chk" /> <label for=""' + item + '"">' + item + '</label> </span>';
            template += '<label><input ' + checkedYr + ' name="payrollYears" type="checkbox" value="' + item + '" class="chk"> <span></span>&nbsp;' + item + '</label>';
        });
        template += '<span class="payrollFitlerDivider"></span>';

        $.each(monthNames, function (i, items) {
            var monthNo = i + 1;
            var checkedMonth = '';
            if (monthNo == sysdate.split('/')[1]) { checkedMonth = 'checked' }
            //template += '<span> <input name="payrollMonths" type="checkbox" value="' + monthNo + '" class="chkm" /> <label for=""' + items + '"">' + items + '</label> </span>';
            template += '<label><input ' + checkedMonth + ' name="payrollMonths" type="checkbox" value="' + monthNo + '" class="chk"> <span></span>&nbsp;' + items + '</label>    ';
        });

        template += '<button class="btn btn-xs btn-primary" onClick="ShowPayrollDashboard();">Show</button>';

        placeholder.html(template);

        $('.chk,.chkm').change(function () {
            //alert(getCheckedCheckboxesFor('payrollYears'));
            var _resYears = getCheckedCheckboxesFor('payrollYears');
            var _resMonths = getCheckedCheckboxesFor('payrollMonths');
            globalpayrrolFilter =
                {
                    Years: _resYears,
                    Months: _resMonths
                }
            //////console.log({ _resYears, _resMonths });
            //        main(globalFilter);
        });

    } else if (FType == 'appraisaldashboard') {

        var template = '';
        var params = { PID1: 'tblReviewYear', PID2: 'ReviewYear', PID3: "ReviewYear", PID4: '' }
        var paramsReviewType = { PID1: 'tblReviewType', PID2: 'ReviewTypeID', PID3: "ReviewTypeTitle", PID4: '' }
        fillDD('ddlReviewYear', params);
        fillDD('ddlReviewType', paramsReviewType);
        fillDD('ddlReviewType2', paramsReviewType);
        $('.mbox').closest('td').css('width', '180px');

    }



}
function ShowPayrollDashboard() {
    main(globalFilter);
}


function GetTurnOverMonthly(ctx, data) {
    $('#' + ctx).closest('div').before('<div class="progressdiv" id="' + ctx + 'progress" style="position:absolute;left:45%;"></div>');

    postRequestD('GetMonthlyTurnover', data, function (response) {
        $('#' + ctx + 'progress').remove();

        var _d = JSON.parse(response.d);

        ////console.table(_d);

        var lbls = [];
        var _data = [];
        var _data1 = [];

        var distinctYear = getDistinctArray(_d, 'Year0');

        ////////console.log({ distinctYear });

        var ds = [];
        $.each(distinctYear, function (i, item) {

            var filterData = _d.filter(function (value) {
                return value.Year0 == item;
            });



            ////////console.log({ filterData });
            _data = [];
            _data1 = [];
            $.each(filterData, function (i, ditem) {



                //lbls.push(monthNames[ditem.Month]);
                var turnOver = ditem.OpeningCount + ditem.ClosingCount != 0 ? ditem.LeftEmployees / ((ditem.OpeningCount + ditem.ClosingCount) / 2) * 100 : 0;
                var retention = ditem.ClosingCount != 0 ? ((ditem.ClosingCount - ditem.LeftEmployees) / ditem.ClosingCount) * 100 : 0;

                var per = turnOver;
                var per2 = retention;


                if (per % 1 !== 0) {
                    per = per.toFixed(2);
                }

                if (per2 % 1 !== 0) {
                    per2 = per2.toFixed(2);
                }

                _data.push(parseFloat(per));
                _data1.push(parseFloat(per2));

            });

            //////////console.log({ _data, _data1 });
            var rcolor = materialColor();
            var chrtTurnover = {
                label: 'Turnover-' + item + '',
                data: _data,
                fill: false,
                type: 'line',
                backgroundColor: rcolor,
                borderColor: rcolor,
                lineTension: 0
            }
            rcolor = materialColor();
            var chrtRetention = {
                label: 'Retention-' + item + '',
                data: _data1,
                fill: false,
                type: 'line',
                backgroundColor: rcolor,
                borderColor: rcolor,
                lineTension: 0,
                borderDash: [2, 3],
            }


            ds.push(chrtTurnover);



        });

        ////////console.log({ ds });
        //////console.table(getDistinctArray(_d, 'Year0'));







        var objdataTurnOver = {
            // datasets: [{
            //     label: 'Turnover-2019',
            //     data: [3, 5, 35, 7, 4, 2, 6, 7, 3, 4, 52, 6, 8],
            //     fill: false,
