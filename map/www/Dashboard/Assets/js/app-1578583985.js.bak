        var pdata4 = { pYears: vyears, pMonths: __Month, pReturnDataType: "summary", pDetailDataFilter: '', pAdditionalDetailWhereClause: '', pFilterCriteria: filterc };
        GetAbsentism('absenteeismbydept', pdata4);

        var pdata6 = { pYears: getYears(2, new Date().getFullYear() - 1), pFilterCriteria: filterc };
        AbsentismLast3Year('absenteeismlast3yrs', pdata6);

        vyears = pFirstLoad == 1 ? '2019' : vyears;
        var pdata3 = { pYears: vyears, pMonths: __Month, pFilterCriteria: filterc };
        //AvgOTByAgeGroup('avgotage', pdata3);
