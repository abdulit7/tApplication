            //     pointBackgroundColor: '#ddd',

            // }
            // ],
            datasets: ds,
            labels: monthNames //lbls.filter(onlyUnique)
        };

        var objdataRetention = {
            // datasets: [{
            //     label: 'Turnover-2019',
            //     data: [3, 5, 35, 7, 4, 2, 6, 7, 3, 4, 52, 6, 8],
            //     fill: false,
            //     type: 'line',
            //     backgroundColor: 'orange',
            //     borderColor: 'orange',
            //     lineTension: 0
            // },

            // {
