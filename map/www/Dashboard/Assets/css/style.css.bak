.drillTable{
    font-size: 12px;
}

.progressdiv{
    left: 0 !important;
    position: absolute;
    background: rgba(225,225,225,.6);
    width: 100%;
    height: 100%;
    top: 0 !important;
    
}

.progressdiv::before{
    content: 'Please wait a moment ...';
    top: 50%;
    text-align: center;
    position: absolute;
    color: #333;
    font-weight:bold;
    left: 50%;
    transform: translate(-50%, -50%);
}

.progress-description, .info-box-text {    
    font-size: 18px;    
    font-weight: bold;
    cursor: pointer;    
}

.attsummarynum{
    font-size:36px;
    text-shadow: 0px 0px 10px #333;
    cursor: pointer;
}