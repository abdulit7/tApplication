        <div class="tab-content">


            <div id="trainingdashboard" class="tab-pane fade hide">
                <div class="row">

                    <div class="col-md-12">
                        <div class="FilterDiv" id="trainingdashboardFilterDiv"> </div>
                    </div>

                    <br>
                    <br>

                    <div class="training-summarybox">
                        <div class="col-md-2">
                            <div class="panel panel-default effect3">
                                <div id="" class="panel-body">
