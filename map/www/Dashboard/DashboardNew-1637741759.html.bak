            <div id="helpdeskdashboard" class="tab-pane fade hide">
                <div class="row">

                    <div class="col-md-12" class="helpDeskDatePicker">
                        <!-- <div class="FilterDiv" id="helpdeskdashboardFilterDiv"> </div> -->


                        <div class="form-inline">
                            <div class="form-group">
                                <label for="txtFromHelpdesk">From Date</label>
                                <div class='input-group date' id='datepickertxtFromHelpdesk'>
                                    <input type='text' id="txtFromHelpdesk" class="form-control" readonly />
                                    <span class="input-group-addon"><span class="glyphicon glyphicon-calendar"></span>
                                    </span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="txtToHelpdesk">To Date:</label>
                                <div class='input-group date' id='datepickertxtToHelpdesk'>
                                    <input type='text' id="txtToHelpdesk" class="form-control" readonly />
                                    <span class="input-group-addon"><span class="glyphicon glyphicon-calendar"></span>
                                    </span>
                                </div>

                            </div>

                        </div>


                    </div>

                    <div class="col-md-12">
                        <div class="panel panel-default effect3">
                            <div id="helpdeskStatusSummary" class="panel-body">
                                <div class="cardheading">Status Summary
                                    <span id="" style="font-size: 15px;" class="pull-right hide"><i class="fa fa-expand"></i></span>
                                </div>
