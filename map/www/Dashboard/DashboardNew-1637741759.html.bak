            <div id="appraisaldashboard" class="tab-pane fade hide">
                <div class="row">

                    <div class="col-md-12">
                        <div class="FilterDiv" id="appraisaldashboardFilterDiv">
                            <center><span style="cursor: pointer;" onclick="$('.innerFilterDiv').slideToggle();">Select
                                    Criteria &nbsp; <i class="fa fa-chevron-up"></i>
                                </span></center>
                            <div class="innerFilterDiv" style="display: none;">
                                Review Year : <select id="ddlReviewYear" multiple="multiple" class="select2ddlAppraisal"></select>
                                Review Type For Perforamnce : <select id="ddlReviewType" multiple="multiple" class="select2ddlAppraisal">
                                </select> &nbsp;
                                Review Type For Potential : <select id="ddlReviewType2" multiple="multiple" class="select2ddlAppraisal"></select>
                                <center>
                                    <button class="btn btn-xs btn-primary" onclick="main(globalFilter);">Show</button>
                                </center>
                            </div>

                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="panel panel-default effect3">
