                                        </div>
                                        <div class="training-title">
                                            No of Completed Training Sessions
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="panel panel-default effect3">
                                <div id="" class="panel-body">
                                    <div class="text-center">
                                        <div class="training-count" id="totalNoOfParticipants">
                                            0
                                        </div>
                                        <div class="training-title">
                                            Total Number of Participants
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="panel panel-default effect3">
                                <div id="" class="panel-body">
                                    <div class="text-center">
                                        <div class="training-count" id="totalTrainingManHours">
                                            0
                                        </div>
                                        <div class="training-title">
                                            Total Man Hours
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="panel panel-default effect3">
                                <div id="" class="panel-body">
                                    <div class="text-center">
                                        <div class="training-count" id="totalTrainingCosts">
                                            0
                                        </div>
                                        <div class="training-title">
                                            Costs
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="panel panel-default effect3">
                                <div id="" class="panel-body">
                                    <div class="text-center">
                                        <div class="training-count" id="totalCostsPerPerson">
                                            0
                                        </div>
                                        <div class="training-title">
                                            Avg Training Cost per Participant
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="panel panel-default effect3">
                                <div id="" class="panel-body">
